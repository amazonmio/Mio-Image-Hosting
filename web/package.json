{
  "name": "mio-image-hosting-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "prettier --write src vite.config.ts tsconfig.json package.json eslint.config.js",
    "format:check": "prettier --check src vite.config.ts tsconfig.json package.json eslint.config.js",
    "lint": "eslint src vite.config.ts --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "check": "npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.0",
    "element-plus": "^2.13.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.1",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.3.8",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.0.0"
  },
  "overrides": {
    "minimatch@^10.0.0": "^11.0.5"
  }
}
